#!/usr/bin/bash
set -euo pipefail

if (($# == 0)); then
    echo "CS2 XIM wrapper: missing game command." >&2
    exit 2
fi

nested_display=""
for _ in {1..100}; do
    nested_display=$(
        ps -eo args= |
            awk '$1 ~ /(^|\/)Xwayland$/ && $2 ~ /^:[0-9]+$/ && /-core/ && /-terminate/ { display = $2 } END { print display }'
    )
    if [[ -n "$nested_display" ]] &&
        DISPLAY="$nested_display" /usr/bin/xprop -root >/dev/null 2>&1; then
        break
    fi
    nested_display=""
    sleep 0.1
done

if [[ -z "$nested_display" ]]; then
    echo "CS2 XIM wrapper: Gamescope XWayland did not become available." >&2
    exit 1
fi

if ! /usr/bin/fcitx5-remote --check >/dev/null 2>&1; then
    echo "CS2 XIM wrapper: Fcitx5 is not running." >&2
    exit 1
fi

registered=0
if ! DISPLAY="$nested_display" /usr/bin/xprop -root XIM_SERVERS 2>/dev/null |
    grep -q '@server=fcitx'; then
    if ! DISPLAY="$nested_display" /usr/bin/fcitx5-remote -x; then
        echo "CS2 XIM wrapper: could not connect Fcitx5 to $nested_display." >&2
        exit 1
    fi

    for _ in {1..30}; do
        if DISPLAY="$nested_display" /usr/bin/xprop -root XIM_SERVERS 2>/dev/null |
            grep -q '@server=fcitx'; then
            registered=1
            break
        fi
        sleep 0.1
    done
else
    registered=1
fi

if (( ! registered )); then
    echo "CS2 XIM wrapper: Fcitx5 did not register XIM on $nested_display." >&2
    exit 1
fi

exec "$@"
